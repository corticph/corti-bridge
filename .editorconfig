root = true

# bin/corti-claude is deliberately absent: it is 4-space, and a broad glob would make editors
# reformat it on open, burying real changes in whitespace churn.
[{setup.sh,lib/*.sh,test/*.sh}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
